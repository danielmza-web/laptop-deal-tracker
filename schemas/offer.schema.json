{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laptops.dazu.xyz/schemas/offer.schema.json",
  "title": "Retail offer",
  "type": "object",
  "required": ["id", "source", "seller", "laptop_id", "url", "condition", "availability", "confidence", "configuration_match", "os_status"],
  "properties": {
    "id": {"type": "string"},
    "source_id": {"type": ["string", "null"]},
    "laptop_id": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "price": {"type": ["number", "null"], "minimum": 0},
    "shipping": {"type": ["number", "null"], "minimum": 0},
    "total_price": {"type": ["number", "null"], "minimum": 0},
    "effective_price": {"type": ["number", "null"], "minimum": 0},
    "value_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "value_rating": {"type": ["string", "null"]},
    "price_breakdown": {"type": ["object", "null"]},
    "currency": {"type": "string"},
    "condition": {"enum": ["new", "used", "refurbished", "open_box"]},
    "availability": {"enum": ["unknown", "in_stock", "out_of_stock", "preorder", "expired", "listing_removed"]},
    "confidence": {"enum": ["low", "medium", "high", "verified"]},
    "configuration_match": {"enum": ["matched", "mismatched", "unidentified", "unverified"]},
    "os_status": {"enum": ["windows_included", "no_os", "linux", "selectable", "unknown"]}
  }
}
